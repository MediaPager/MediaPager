# Copy this file to .env and fill in values for your deployment.
# Compose requires the qnet name, web IP, and host data/media directories.

# QNAP qnet network name that gives the web container its own LAN IP.
# Find yours: docker network ls  (look for qnet-static-ethX-...)
MEDIAPAGER_QNET_NETWORK=qnet-static-eth0-XXXX

# Free static LAN IP for the web UI (the SPA is served here on port 80).
MEDIAPAGER_WEB_IP=192.168.1.50

# Host directory where the SQLite DB + app state persist (mounted at /data).
MEDIAPAGER_DATA_DIR=/path/to/persistent/data

# Optional database file path inside the API container (defaults under /data).
# MEDIAPAGER_DB_PATH=/data/db/mediapager-auth.db

# Host directory holding your movie library (mounted at /mnt/movies).
MEDIAPAGER_MOVIES_DIR=/path/to/movies

# First-run super-admin email (created only if it doesn't already exist).
# Temporary password is printed once to: docker compose logs mediapager-api
MEDIAPAGER_SEED_USER=you@example.com

# Optional: set a fixed initial admin password. Leave unset to generate a temporary one.
# MEDIAPAGER_SEED_PASS=

# Optional: stable JWT signing key (at least 32 bytes). Keep it private and stable.
# MEDIAPAGER_EKEY=

# Optional: TMDB API key. A key saved in Settings takes precedence over this value.
# MEDIAPAGER_TMDB_API_KEY=

# Optional: Docker config dir for private GHCR pulls (Watchtower).
# Defaults to /root/.docker if unset.
# DOCKER_CONFIG=/root/.docker

# Optional: Watchtower poll interval (seconds). Defaults to 3600.
# WATCHTOWER_POLL_INTERVAL=3600
