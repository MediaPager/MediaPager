# Optional overrides. Compose works without an .env file.

# Docker Hub image to run.
MEDIAPAGER_IMAGE=mediapager/mediapager:latest

# Host port for the single MediaPager container.
MEDIAPAGER_PORT=8080

# Public base URL used when the app creates links in email.
MEDIAPAGER_BASE_URL=http://localhost:8080

# Host folder containing your media; mounted read-only at /mnt/media.
MEDIAPAGER_MEDIA_PATH=./media

# Optional initial admin email (used only if the database has no super-admin yet).
MEDIAPAGER_SEED_USER=admin@mediapager.local

# Optional: set a fixed first-run password; otherwise a temporary password is logged once.
# MEDIAPAGER_SEED_PASS=

# Optional: stable JWT signing key (at least 32 bytes). Keep it private and stable.
# MEDIAPAGER_EKEY=

# Optional: TMDB API key. A key saved in Settings takes precedence over this value.
# MEDIAPAGER_TMDB_API_KEY=
