# Compose works without this file. Copy it to .env and change only values you need.

# Container and public URL
MEDIAPAGER_IMAGE=mediapager/mediapager:latest
MEDIAPAGER_PORT=8080
MEDIAPAGER_BASE_URL=http://localhost:8080

# Persistent application data volume. Do not use this for large catalog media by default.
MEDIAPAGER_DATA_ROOT=/data

# Optional host locations mapped into the /data tree inside the container.
# MEDIAPAGER_SQLITE_PATH=/data/db/mediapager-auth.db
# MEDIAPAGER_POSTER_DIRECTORY=/data/artwork/posters
# MEDIAPAGER_BACKGROUND_DIRECTORY=/data/artwork/backgrounds
# MEDIAPAGER_CONFIG_DIRECTORY=/data/config
# MEDIAPAGER_SIGNING_KEY_PATH=/data/keys/signing.key
# MEDIAPAGER_DATA_PROTECTION_KEYS=/data/keys/data-protection
# MEDIAPAGER_TOOLS_DIRECTORY=/data/tools
# MEDIAPAGER_COMMUNITY_PLUGINS_DIRECTORY=/data/plugins/community
# MEDIAPAGER_INSTALLED_OFFICIAL_DIRECTORY=/data/plugins/official

# Media stays separate from app data. Compose mounts this host folder at /mnt/media.
# Set to a large host/NAS path, then create catalogs using /mnt/media/... paths.
MEDIAPAGER_MEDIA_PATH=./media

# Initial admin (only used when there is no super-admin in the selected database).
MEDIAPAGER_SEED_USER=admin@mediapager.local
# MEDIAPAGER_SEED_PASS=

# Optional stable JWT HMAC signing key, at least 32 UTF-8 bytes. Keep it secret.
# MEDIAPAGER_EKEY=

# Optional provider configuration fallback.
# MEDIAPAGER_TMDB_API_KEY=

# Bundled PostgreSQL stack (docker-compose.postgres.yml only).
# POSTGRES_DB=mediapager
# POSTGRES_USER=mediapager
# POSTGRES_PASSWORD=use-a-strong-password
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_SSL_MODE=Prefer
# POSTGRES_CONNECT_TIMEOUT=15

# External PostgreSQL with docker-compose.yml (Compose aliases, mapped to Settings:Db).
# MEDIAPAGER_DATABASE_PROVIDER=PostgreSQL
# MEDIAPAGER_AUTH_CONNECTION_STRING=Host=db-host;Port=5432;Database=mediapager;Username=mediapager;Password=change-me
